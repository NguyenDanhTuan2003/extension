{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/extention_notice/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/extention_notice/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/extention_notice",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "extention_notice": {
      "type": "application",
      "root": "apps/extention_notice",
      "entryFile": "main",
      "sourceRoot": "apps/extention_notice/src",
      "compilerOptions": {
        "tsConfigPath": "apps/extention_notice/tsconfig.app.json"
      }
    },
    "notice-service": {
      "type": "application",
      "root": "apps/notice-service",
      "entryFile": "main",
      "sourceRoot": "apps/notice-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notice-service/tsconfig.app.json"
      }
    },
    "commons": {
      "type": "library",
      "root": "libs/commons",
      "entryFile": "index",
      "sourceRoot": "libs/commons/src",
      "compilerOptions": {
        "tsConfigPath": "libs/commons/tsconfig.lib.json"
      }
    }
  }
}